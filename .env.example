# Local defaults. In production, set ENVIRONMENT=production in the deployment platform.
ENVIRONMENT=development
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://jarvis:change-me@db:5432/jarvis
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=1440
DEFAULT_ADMIN_EMAIL=admin@jarvis.example.com
DEFAULT_ADMIN_PASSWORD=change-me-now
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_BASE=/api/backend

# AI integration. Keep deterministic for key-free local and dry-run operation.
AI_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20

# Production Docker Compose only. Create this external network with your reverse proxy.
PROXY_NETWORK=jarvis-proxy

# Production requirements (set these in the deployment platform or .env.production; never commit secrets).
# ENVIRONMENT=production
# JWT_SECRET=<random-string-with-at-least-32-characters>
# DEFAULT_ADMIN_PASSWORD=<unique-password-with-at-least-12-characters>
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
# REDIS_URL=redis://<host>:6379/0
